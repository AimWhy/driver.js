---
import Container from "./Container.astro";
---

<div class="bg-white border-b border-gray-200 select-none">
  <Container>
    <div class="flex items-center justify-between h-16">
      <a href="/" data-nav-logo class="flex items-center justify-end text-xl font-bold text-gray-900 font-semibold gap-2.5">
        <img src="/mascot-head.png" alt="driver.js logo" width="900" height="775" class="h-10 w-auto" />
        driver.js
      </a>
      <span class="flex items-center gap-3">
        <a href="/docs/installation" data-nav-docs class="rounded-lg px-3 py-1.5 text-base font-medium text-gray-900 transition-colors hover:bg-gray-100">
          <span class="hidden sm:inline">Documentation</span>
          <span class="inline sm:hidden">Docs</span>
        </a>
        <a href="https://github.com/nilbuild/driver.js" target="_blank" aria-label="GitHub" class="text-gray-900 hover:text-gray-600">
          <svg viewBox="0 0 496 512" fill="currentColor" class="h-6 w-6" aria-hidden="true">
            <path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z"></path>
          </svg>
        </a>
      </span>
    </div>
  </Container>
</div>
<div class="bg-yellow-300/80 overflow-hidden via-transparent">
  <Container>
    <div class="py-10 md:py-14 lg:py-25 flex justify-start items-center gap-4">
      <div class="flex-grow" data-hero-text>
        <h1 data-driver-name class="text-7xl md:text-8xl lg:text-9xl mb-2 md:mb-3 lg:mb-4 font-bold">driver.js</h1>
        <p data-driver-tagline class="text-base md:text-2xl lg:text-3xl !leading-normal">
          Lightweight JavaScript library for product tours, highlights, and contextual help for your
          product.
        </p>
        <div class="mt-4 md:mt-8 lg:mt-10 flex flex-col sm:flex-row gap-4 items-stretch">
          <div class="relative" data-demo-split>
            <div
              class="flex items-stretch overflow-hidden rounded-2xl border-2 border-black bg-gray-800 text-white shadow-[5px_5px_0_0_#000] transition-all active:translate-x-[3px] active:translate-y-[3px] active:shadow-[2px_2px_0_0_#000]"
            >
              <button
                data-demo-tour
                class="flex-1 cursor-pointer px-7 py-2.5 md:py-3 text-lg md:text-xl font-semibold hover:bg-gray-700 focus:outline-none focus-visible:outline-none"
              >
                Show Demo
              </button>
              <button
                data-demo-menu-toggle
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label="Choose a demo"
                class="flex cursor-pointer items-center border-l-2 border-black px-3 hover:bg-gray-700 focus:outline-none focus-visible:outline-none"
              >
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
            <div
              data-demo-menu
              class="fixed z-50 hidden w-56 overflow-hidden rounded-xl border-2 border-black bg-white shadow-[4px_4px_0_0_#000]"
            >
              <button data-demo-item="tour" type="button" class="block w-full cursor-pointer px-4 py-2.5 text-left text-base font-medium text-black hover:bg-yellow-200">Product tour</button>
              <button data-demo-item="hints" type="button" class="block w-full cursor-pointer border-t-2 border-black px-4 py-2.5 text-left text-base font-medium text-black hover:bg-yellow-200">Feature hints</button>
              <button data-demo-item="highlight" type="button" class="block w-full cursor-pointer border-t-2 border-black px-4 py-2.5 text-left text-base font-medium text-black hover:bg-yellow-200">Simple highlight</button>
              <button data-demo-item="checklist" type="button" class="block w-full cursor-pointer border-t-2 border-black px-4 py-2.5 text-left text-base font-medium text-black hover:bg-yellow-200">Onboarding checklist</button>
            </div>
          </div>
          <a
            href="/docs/installation"
            data-docs-link
            class="cursor-pointer rounded-2xl border-2 border-black bg-white px-7 py-2.5 md:py-3 text-center text-lg md:text-xl font-semibold text-black shadow-[5px_5px_0_0_#000] transition-all hover:bg-gray-100 active:translate-x-[3px] active:translate-y-[3px] active:shadow-[2px_2px_0_0_#000] focus:outline-none focus-visible:outline-none"
          >
            Get Started
          </a>
        </div>
      </div>
      <div class="flex-shrink-0 hidden sm:flex">
        <img src="/fox-mascot.png" alt="driver.js mascot" width="1130" height="744" class="w-auto sm:h-56 md:h-64 lg:h-[300px] relative top-[12px]" />
      </div>
    </div>
  </Container>
</div>

<style is:global>
  .hero-hint-beacon {
    --driver-hint-size: 30px;
  }

  .driver-popover.hero-hint-popover {
    background-color: #ffffff;
    color: #111827;
    border-radius: 14px;
    box-shadow:
      0 14px 34px rgba(17, 24, 39, 0.18),
      0 2px 6px rgba(17, 24, 39, 0.08);
  }

  .driver-popover.hero-hint-popover .driver-popover-title {
    color: #111827;
    font-weight: 600;
  }

  .driver-popover.hero-hint-popover .driver-popover-description {
    color: rgba(17, 24, 39, 0.66);
  }

  .driver-popover.hero-hint-popover .driver-popover-close-btn {
    color: rgba(17, 24, 39, 0.55);
  }
  .driver-popover.hero-hint-popover .driver-popover-close-btn:hover {
    color: #111827;
  }

  .driver-popover.hero-hint-popover .driver-popover-footer-btn {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    text-shadow: none;
    font-weight: 400;
    font-size: 13px;
    padding: 9px 20px;
    box-shadow: none;
  }

  .driver-popover.hero-hint-popover .driver-popover-footer-btn:hover {
    background-color: #4338ca;
  }

  .driver-popover.hero-hint-popover .driver-popover-arrow-side-left.driver-popover-arrow {
    border-left-color: #ffffff;
  }
  .driver-popover.hero-hint-popover .driver-popover-arrow-side-right.driver-popover-arrow {
    border-right-color: #ffffff;
  }
  .driver-popover.hero-hint-popover .driver-popover-arrow-side-top.driver-popover-arrow {
    border-top-color: #ffffff;
  }
  .driver-popover.hero-hint-popover .driver-popover-arrow-side-bottom.driver-popover-arrow {
    border-bottom-color: #ffffff;
  }
</style>

<script>
  import { driver } from "driver.js";
  import "driver.js/dist/driver.css";
  import { hints } from "driver.js/hints";
  import "driver.js/dist/hints.css";

  const split = document.querySelector("[data-demo-split]");
  if (split) {
    const toggle = split.querySelector("[data-demo-menu-toggle]");
    const menu = split.querySelector("[data-demo-menu]");

    const closeMenu = () => {
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };
    const positionMenu = () => {
      const rect = split.getBoundingClientRect();
      menu.style.top = `${rect.bottom + 8}px`;
      menu.style.left = `${rect.left}px`;
    };
    const openMenu = () => {
      positionMenu();
      menu.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", event => {
      event.stopPropagation();
      if (menu.classList.contains("hidden")) {
        openMenu();
        return;
      }
      closeMenu();
    });

    document.addEventListener("click", event => {
      if (!split.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });

    window.addEventListener("scroll", closeMenu, { passive: true });
    window.addEventListener("resize", closeMenu);

    let heroHints = null;
    const runHints = () => {
      if (!heroHints) {
        heroHints = hints({
          popoverClass: "hero-hint-popover",
          beacon: { className: "hero-hint-beacon" },
          hints: [
            {
              element: "[data-nav-logo]",
              id: "logo",
              beacon: { side: "bottom", align: "end" },
              popover: {
                description:
                  "<img src='/fox-looking.gif' alt='' style='display:block;width:100px;height:100px;margin:0 auto 20px;' />A pulsing beacon marks a spot and opens a popover when clicked.",
                side: "bottom",
                align: "start",
                showButton: false,
              },
            },
            {
              element: "[data-nav-docs]",
              id: "docs",
              beacon: { side: "bottom", align: "start" },
              popover: {
                title: "Read the docs",
                description: "Full guides for tours, highlights, and hints.",
                side: "bottom",
                align: "start",
                buttonText: "Read the docs",
              },
            },
            {
              element: "[data-docs-link]",
              id: "get-started",
              beacon: { side: "top", align: "end" },
              popover: {
                title: "No overlay",
                description: "The page stays fully interactive while a hint is open.",
                side: "top",
                align: "end",
              },
            },
          ],
        });
      } else {
        // Re-running the demo brings every hint back, even dismissed ones.
        heroHints.restoreAll();
      }

      heroHints.show();
    };

    const runHighlight = () => {
      const driverObj = driver({ popoverClass: "driverjs-theme" });
      driverObj.highlight({
        element: "[data-driver-tagline]",
        popover: {
          title: "Simple highlight",
          description: "Spotlight a single element with a popover, no tour required.",
          side: "bottom",
          align: "start",
        },
      });
    };

    const tourButton = document.querySelector<HTMLElement>("[data-demo-tour]");
    if (tourButton) {
      tourButton.addEventListener("click", () => {
        closeMenu();
      });
    }

    const tourItem = split.querySelector('[data-demo-item="tour"]');
    if (tourItem && tourButton) {
      tourItem.addEventListener("click", () => {
        closeMenu();
        tourButton.click();
      });
    }

    const hintsItem = split.querySelector('[data-demo-item="hints"]');
    if (hintsItem) {
      hintsItem.addEventListener("click", () => {
        closeMenu();
        runHints();
      });
    }

    const highlightItem = split.querySelector('[data-demo-item="highlight"]');
    if (highlightItem) {
      highlightItem.addEventListener("click", () => {
        closeMenu();
        runHighlight();
      });
    }

    // Started from the homepage checklist, which can be anywhere down the page.
    document.addEventListener("driver-docs:show-hints", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
      runHints();
    });

    const checklistItem = split.querySelector('[data-demo-item="checklist"]');
    if (checklistItem) {
      checklistItem.addEventListener("click", () => {
        closeMenu();
        // Owned by the examples section, which also has a button for it.
        document.dispatchEvent(new CustomEvent("driver-docs:show-checklist"));
      });
    }
  }
</script>
